# ========================
# 1. SEGURIDAD (CRÍTICO)
# ========================
# Ignorar todos los archivos .env en cualquier carpeta
.env
**/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Claves privadas y certificados
*.pem
*.key

# ========================
# 2. SISTEMA OPERATIVO & IDEs
# ========================
# Windows (importante para tus compañeros)
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# MacOS
.DS_Store

# VS Code / Editores
.vscode/
.idea/
*.swp

# ========================
# 3. PYTHON (BACKEND)
# ========================
# Bytecode compilado
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales (tu carpeta venv)
venv/
env/
.venv/
backend/venv/

# Base de datos local (si usaran SQLite alguna vez)
*.sqlite3
*.db

# ========================
# 4. JAVASCRIPT / EXPO (FRONTEND)
# ========================
# Dependencias masivas (nunca subir esto)
node_modules/
appVinculo/node_modules/

# Logs de errores
npm-debug.log*
yarn-error.log*
yarn-debug.log*

# Builds de Expo y web
.expo/
dist/
web-build/

# ========================
# 5. DOCKER & OTROS
# ========================
# Si alguien crea un override local para docker
docker-compose.override.yml

# Logs del sistema
*.log